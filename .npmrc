# A Vercel seta NODE_ENV=production durante o build, e por padrão o npm usa
# isso pra pular devDependencies inteiras (typescript, @types/*, eslint) —
# que ficam só no package.json da raiz do workspace, mas são exigidas pelo
# `next build` de apps/web e packages/design-system. Sem isso, o deploy
# falha com "It looks like you're trying to use TypeScript but do not have
# the required package(s) installed".
include=dev
